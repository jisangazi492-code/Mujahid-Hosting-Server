# Set these as Environment Variables in Render; never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
PORT=10000
# Optional: if using a separate domain for uploaded sites, set it here.
# Example: SITE_BASE_DOMAIN=sites.example.com
SITE_BASE_DOMAIN=
